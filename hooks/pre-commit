#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2023-2026 Ron June Valdoz
#
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# 1. Verify Copyright & SPDX headers on staged files (if tool exists)
if [ -f "$repo_root/tools/verify_copyright_headers.py" ]; then
  if ! python3 "$repo_root/tools/verify_copyright_headers.py" --staged; then
    echo "pre-commit hook: staged first-party source is missing required copyright/SPDX header." >&2
    exit 1
  fi
fi

# 2. Secret & Token Scanner (gitleaks)
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --pre-commit --redact --staged --no-banner; then
    echo "pre-commit hook: gitleaks found a likely secret in staged changes." >&2
    echo "Remove it, or add a verified false positive to .gitleaks.toml." >&2
    exit 1
  fi
fi

# 3. Large Binary File Guard (> 15MB check)
max_bytes=15728640
large_files=$(git diff --cached --name-only | while read -r f; do
  if [ -f "$f" ]; then
    size=$(wc -c < "$f" | tr -d ' ')
    if [ "$size" -gt "$max_bytes" ]; then
      echo "$f ($(( size / 1048576 ))MB)"
    fi
  fi
done)

if [ -n "$large_files" ]; then
  echo "pre-commit hook: staged file exceeds 15MB size limit (use Git LFS or external assets):" >&2
  echo "$large_files" >&2
  exit 1
fi

# 4. Lesson Harvesting Reminder
if git diff --cached --name-only | grep -q "^docs/lessons/"; then
  echo "💡 [kmp-agent-skills] New lesson staged! Run '/kmp-harvest-lessons' when ready to upstream patterns."
fi

# 5. Self-Healing Docs Sitemap (if docs/ was modified)
if git diff --cached --name-only | grep -q "^docs/.*\.md$"; then
  if [ -f "$repo_root/scripts/heal_docs.py" ]; then
    python3 "$repo_root/scripts/heal_docs.py" --project "$repo_root" >/dev/null 2>&1 || true
    if [ -f "$repo_root/docs/README.md" ]; then
      git add "$repo_root/docs/README.md"
    fi
  fi
fi

# 6. Lightweight Architecture Smell Scan (if hook script exists)
if [ -f "$repo_root/hooks/pre-commit-audit.sh" ]; then
  exec "$repo_root/hooks/pre-commit-audit.sh"
fi

